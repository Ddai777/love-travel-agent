# ========== LLM 网关配置 ==========
# 必填：模型网关鉴权 Key。可用 EdgeOne Makers Models 的 Key，或任意 OpenAI 兼容服务商的 Key。
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
# 可选：模型 ID，默认 @makers/deepseek-v4-flash（内置免费模型）
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ========== 高德地图配置 ==========
# 必填：高德开放平台 Web 服务 API Key（用于地点解析、商场搜索、距离计算）
# 申请地址：https://console.amap.com/dev/key/app  （服务平台选「Web服务」）
AMAP_API_KEY=your-amap-web-service-key
